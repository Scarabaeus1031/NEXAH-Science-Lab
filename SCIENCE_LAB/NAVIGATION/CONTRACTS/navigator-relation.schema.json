{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexah.de/schemas/navigator-relation.schema.json",
  "title": "NEXAH Navigator Relation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "relation_id",
    "source_id",
    "target_id",
    "relation_type",
    "explanation",
    "preserves",
    "does_not_imply",
    "claim_boundary",
    "status",
    "visibility"
  ],
  "properties": {
    "relation_id": {"type": "string", "pattern": "^REL:[A-Z0-9][A-Z0-9:_-]*$"},
    "source_id": {"type": "string", "minLength": 2},
    "target_id": {"type": "string", "minLength": 2},
    "relation_type": {
      "enum": [
        "exact-copy",
        "version-successor",
        "shared-source",
        "contains-view",
        "represents",
        "method-grammar",
        "tested-transform",
        "empirical-support",
        "negative-control",
        "historical-predecessor",
        "application-analogy",
        "post-hoc-context",
        "qualified-comparator",
        "operational-comparator",
        "representation-expansion",
        "negative-boundary",
        "open-candidate",
        "non-identity"
      ]
    },
    "explanation": {"type": "string", "minLength": 24},
    "evidence_record_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "preserves": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 2}
    },
    "does_not_imply": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 2}
    },
    "claim_boundary": {"type": "string", "minLength": 12},
    "status": {"enum": ["verified", "bounded", "provisional", "historical", "open", "rejected"]},
    "visibility": {"enum": ["internal", "public_candidate", "public"]},
    "confidence": {"enum": ["high", "medium", "low", "not_applicable"]}
  }
}
