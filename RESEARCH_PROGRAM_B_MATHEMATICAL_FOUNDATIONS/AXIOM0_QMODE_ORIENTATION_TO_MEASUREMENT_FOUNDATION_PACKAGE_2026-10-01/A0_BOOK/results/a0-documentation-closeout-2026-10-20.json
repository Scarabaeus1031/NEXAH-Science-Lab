    ],
    [
      "DOC-02",
      "Currentness und historische Receipt-Abweichungen",
      "RECONCILIATION_OPEN",
      "Verbleibende Currentness-Abweichungen, den dokumentarischen Findings-&-Paper-Workspace-Pin und die zwei vor Closeout fehlschlagenden historischen Prüfpfade einzeln disponieren.",
      "Jede Abweichung hat Originalpin, Isthash, Ursache/Scope und Entscheidung: behalten, expliziter Nachfolger oder getrennte Reparatur. Kein pauschales Neupinnen."
    ],
    [
      "DOC-03",
      "ORION-Tube-Original wiederfinden",
      "SOURCE_RECOVERY_OPEN",
      "Genauen Autorenrecord, Script oder Notebook für die erinnerte Tube-/Flächenkonstruktion finden.",
      "Pfad/Revision/Hash und tatsächliche Ein-/Ausgaben samt Formel; Owner-Herkunft bleibt von zertifiziertem Repository-Scope getrennt."
    ],
    [
      "DOC-04",
      "Tube als Verteiler präzisieren",
      "DESIGN_ONLY_NOT_ACTIVE",
      "Für genau einen vorhandenen Träger Eingangsrecord, Routingregel, Ausgangsadresse und Rückschlüssel beschreiben.",
      "Expliziter Vertrag samt Kollision, Fehlerschlüssel und Verlustgrenze; keine neue Engine oder Versuchsausführung aus diesem To-do."
    ],
    [
      "DOC-05",
      "Farbrollen und Dreiergruppen",
      "OWNER_CONTEXT_REVIEW_OPEN",
      "Cyan/goldene 1, Grün als Kopplung, gelber Chor, ị/}{ und Matroschka-Ebene am jeweiligen Original zuordnen.",
      "Quelle, Ebene, Rolle, Ansicht und Gegenbeispiel je Zuordnung; keine globale Farb-Zahl-Tabelle oder kanonische Umbenennung ohne Owner-Entscheidung."
    ],
    [
      "DOC-06",
      "Teller und zwei Schlaufen",
      "SOURCE_RECOVERY_OPEN",
      "Siebener-Tellerstapel und Visual einer Fläche mit großer/kleiner Schlaufe identifizieren.",
      "Konkretes Bild/Modell mit Adressen, Nachbarschaft und gegebenenfalls Randverklebung; 6|1|6-Zustände bleiben von sechs geometrischen Tellern verschieden."
    ],
    [
      "DOC-07",
      "Skalenlift und Zahlencontainer",
      "SOURCE_AND_CONTRACT_OPEN",
      "Generator des 204→2040-Visuals lokalisieren und Adresstypen CRT/QRT/11-Space mitführen.",
      "Bezugsraum, Einheit, Dezimal-/Tupelnotation, Decoder und Verlustgrenze explizit; bekannte Rechenbeispiele nicht als neuer Satz ausgeben."
    ],
    [
      "DOC-08",
      "Gruppierungen und Registerübergänge",
      "DESIGN_ONLY_NOT_ACTIVE",
      "3+1/4+1/5+1/6+1, 28/32 und erinnerte Rhythmus-/r-Stufen anhand vorhandener Definitionen vergleichen.",
